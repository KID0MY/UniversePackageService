  m_Script: {fileID: 11500000, guid: 12550e90c236e0541b910f7291e37631, type: 3}
  m_Name: NPC_Drasil 3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueFinal
  Node:
  - sentences:
    - text: "I was in the forest this one time and I saw this tree fall, and I swear
        it didn\u2019t make a sound! It was a bad fall too, and it didn\u2019t let
        out so much as an \u201COuch\u201D. Impressive."
  - sentences:
    - text: "You know they say you reap what you sow\u2026. I don\u2019t know who
        said that but if that\u2019s what they\u2019re doing I\u2019d kindly ask
        that they stop sowing."
  - sentences:
    - text: Deliver anything weird today?
